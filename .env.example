# Copy to .env (never commit it). Everything here is read by pipeline/spec.py; see docs/design.md.

# --- SQL Server (the source of record) ---
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DB=ML_Model
MSSQL_ENCRYPT=true
MSSQL_TRUST_CERT=false
MSSQL_READ_USER=mlp_cdc_read           # sql/sqlserver/read_login.sql  (SELECT only; used by the JDBC sources)
MSSQL_READ_PASSWORD=
MSSQL_INBOX_USER=mlp_cdc_inbox         # sql/sqlserver/cdc_inbox.sql   (writes CDC_IN.* only; used by the write-back sinks)
MSSQL_INBOX_PASSWORD=

# --- the platform's PostgreSQL ---
LANDING_HOST=                          # where the landing schema lives (normally the app database)
LANDING_PORT=5432
LANDING_DB=mlp
LANDING_USER=landing_writer
LANDING_PASSWORD=
APP_PG_HOST=                           # the app database the write-back connector reads (wal_level=logical)
APP_PG_PORT=5432
APP_PG_DB=mlp
APP_PG_REPLICATION_USER=debezium       # sql/postgres/replication_role.sql
APP_PG_REPLICATION_PASSWORD=
WRITEBACK_SLOT=mlp_writeback           # same as CDC_WRITEBACK_SLOT / CDC_WRITEBACK_PUBLICATION in the app
WRITEBACK_PUBLICATION=mlp_writeback

# --- what to read ---
RETENTION_DAYS=365                     # the app works on one year of leads
PROGRAMME_CODES=                       # e.g. 1001,22,23 ; blank = every programme
SYNC_TIMES=06:00,12:00,17:00           # local time (TZ below)
TZ=Africa/Johannesburg
DB_TIMEZONE=Africa/Johannesburg        # zone of SQL Server's LOAD_DATE / UPDATE_DATE values (open question D18)
BATCH_MAX_ROWS=5000                    # rows per query against SQL Server
SETTLE_MS=60000                        # ignore rows newer than this, so a batch still being committed is read whole next time
MAX_RUN_MINUTES=60
IDLE_SECONDS=90
